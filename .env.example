# Copy to .env and fill in. .env is git-ignored. Never paste keys into a chat.

# --- The model's API key(s) ---
# OpenAI: https://platform.openai.com/api-keys  (a ChatGPT Plus plan is NOT API access)
OPENAI_API_KEY=sk-...

# Google Gemini (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# Fail over to more keys automatically when the first hits its rate limit:
# PILOT_API_KEY_2=...
# PILOT_API_KEY_3=...
# (or all at once, primary first:)
# PILOT_API_KEYS=key1,key2,key3

# Optional overrides
# PILOT_MODEL=gemini-2.0-flash
# PILOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# PILOT_AUTO_APPROVE=false

# --- Remote control panel (pilot --serve) ---
# A long random string; required to open the control panel.
# PILOT_SERVER_TOKEN=change-me-to-something-long-and-random

# --- Logins the agent can use by name ---
# The model only ever sees the name ("gmail"), never the values.
# Pattern: PILOT_SECRET_<NAME>_USER / _PASS / _VALUE
# PILOT_SECRET_GMAIL_USER=you@gmail.com
# PILOT_SECRET_GMAIL_PASS=your-password
