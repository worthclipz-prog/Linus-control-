# Copy to .env and fill in. .env is git-ignored.

# OpenAI API key from https://platform.openai.com/api-keys
# (A ChatGPT Plus subscription does NOT include API access.)
OPENAI_API_KEY=sk-...

# Optional overrides
# PILOT_MODEL=gpt-4o
# PILOT_BASE_URL=https://api.openai.com/v1
# PILOT_AUTO_APPROVE=false

# Logins the agent can use by name. The model only ever sees the name ("gmail"),
# never the values. Pattern: PILOT_SECRET_<NAME>_USER / _PASS / _VALUE
# PILOT_SECRET_GMAIL_USER=you@gmail.com
# PILOT_SECRET_GMAIL_PASS=your-password
